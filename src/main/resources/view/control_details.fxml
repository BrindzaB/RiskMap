<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ControlDetailsController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
            <Button text="Back" onAction="#onBack"/>
            <HBox HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">
            <!-- Control Details Section -->
            <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 10;">
                <Label text="Control Details" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="Name:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="nameLabel" text=""/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Owner:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="ownerLabel" text=""/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Description:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="descriptionLabel" text="" wrapText="true"/>
                </VBox>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="Impact:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="impactLabel" text=""/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Likelihood:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="likelihoodLabel" text=""/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Audit Results Section -->
            <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 10;">
                <Label text="Audit Results" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <TableView fx:id="auditResultTable">
                    <columns>
                        <TableColumn fx:id="auditIdColumn" text="ID" />
                        <TableColumn fx:id="auditDateColumn" text="Date" />
                        <TableColumn fx:id="auditResultColumn" text="Result" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>